{
  "name": "koishi-plugin-qq-ban",
  "version": "0.0.0",
  "description": "Koishi plugin that mutes and unmutes QQ group members through the QQ official bot adapter.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "yakumo build",
    "clean": "yakumo clean",
    "pack:check": "npm pack --dry-run --cache .npm-cache",
    "publish:npm": "npm publish"
  },
  "files": [
    "lib",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mingmoe/koishi-plugin-qq-ban.git"
  },
  "homepage": "https://github.com/mingmoe/koishi-plugin-qq-ban#readme",
  "bugs": {
    "url": "https://github.com/mingmoe/koishi-plugin-qq-ban/issues"
  },
  "keywords": [
    "koishi",
    "koishi-plugin",
    "qq",
    "ban",
    "mute",
    "禁言"
  ],
  "devDependencies": {
    "koishi": "^4.18.7",
    "typescript": "^5.6.2",
    "yakumo": "^1.0.0-beta.21",
    "yakumo-esbuild": "^1.0.0-beta.7",
    "yakumo-tsc": "^1.0.0-beta.5"
  },
  "peerDependencies": {
    "koishi": "^4.18.7"
  },
  "koishi": {
    "description": {
      "en": "Use command to mute and unmute QQ group members.",
      "zh": "通过指令来控制 QQ 群成员禁言与解禁。"
    },
    "locales": [
      "zh-CN",
      "en-US"
    ]
  },
  "publishConfig": {
    "provenance": false,
    "registry": "https://registry.npmjs.org"
  },
  "directories": {
    "doc": "docs",
    "lib": "lib"
  },
  "author": "ming"
}
